{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "URM native model-level pretraining profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "generated_utc",
    "provenance",
    "backend",
    "diagnostic",
    "configuration",
    "scope",
    "trace_file",
    "nvtx_command",
    "ranges",
    "compiler_execution",
    "state_stage_spans"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_kind": {
      "const": "pretraining_step_profile"
    },
    "generated_utc": {
      "type": "string"
    },
    "backend": {
      "const": "urm_native"
    },
    "diagnostic": {
      "type": "boolean"
    },
    "scope": {
      "const": "one_complete_eager_optimizer_step_after_one_warmup_step"
    },
    "trace_file": {
      "type": "string"
    },
    "nvtx_command": {
      "type": "string"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_revision",
        "dirty_tree",
        "benchmark_command",
        "config_hash",
        "solver_version",
        "python",
        "platform",
        "pytorch",
        "triton",
        "cuda",
        "driver",
        "gpu",
        "gpu_uuid"
      ],
      "properties": {
        "git_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty_tree": {
          "type": "boolean"
        },
        "benchmark_command": {
          "type": "string"
        },
        "config_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "solver_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "python": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "pytorch": {
          "const": "2.8.0"
        },
        "triton": {
          "const": "3.4.0"
        },
        "cuda": {
          "type": "string"
        },
        "driver": {
          "type": "string"
        },
        "gpu": {
          "const": "NVIDIA A10G"
        },
        "gpu_uuid": {
          "type": "string"
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vocab_size",
        "sequence_length",
        "layers",
        "width",
        "heads",
        "value_dim",
        "mlp_ratio",
        "slots_per_partition",
        "reads",
        "writes",
        "microbatch",
        "gradient_accumulation",
        "dropout",
        "bias"
      ],
      "properties": {
        "vocab_size": {
          "type": "integer"
        },
        "sequence_length": {
          "type": "integer"
        },
        "layers": {
          "type": "integer"
        },
        "width": {
          "type": "integer"
        },
        "heads": {
          "type": "integer"
        },
        "value_dim": {
          "type": "integer"
        },
        "mlp_ratio": {
          "type": "integer"
        },
        "slots_per_partition": {
          "type": "integer"
        },
        "reads": {
          "type": "integer"
        },
        "writes": {
          "type": "integer"
        },
        "microbatch": {
          "type": "integer"
        },
        "gradient_accumulation": {
          "type": "integer"
        },
        "dropout": {
          "type": "number"
        },
        "bias": {
          "type": "boolean"
        }
      }
    },
    "ranges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "count",
          "cpu_time_total_us",
          "device_time_total_us",
          "cpu_memory_usage_bytes",
          "device_memory_usage_bytes"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^pretraining::"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "cpu_time_total_us": {
            "type": "number",
            "minimum": 0
          },
          "device_time_total_us": {
            "type": "number",
            "minimum": 0
          },
          "cpu_memory_usage_bytes": {
            "type": "integer"
          },
          "device_memory_usage_bytes": {
            "type": "integer"
          }
        }
      }
    },
    "compiler_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer_count",
        "plan",
        "all_layers_identical",
        "benchmark_direct_backend_instantiation"
      ],
      "properties": {
        "layer_count": {
          "type": "integer",
          "minimum": 1
        },
        "all_layers_identical": {
          "const": true
        },
        "benchmark_direct_backend_instantiation": {
          "const": false
        },
        "plan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "program",
            "steps",
            "obligations",
            "escape_hatch_count"
          ],
          "properties": {
            "program": {
              "const": "compiled_sparse_memory"
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "step_id",
                  "kind",
                  "anchor",
                  "exchanges",
                  "note",
                  "launch_config"
                ],
                "properties": {
                  "step_id": {
                    "const": 0
                  },
                  "kind": {
                    "const": "anchor_dispatch"
                  },
                  "anchor": {
                    "const": "urm_native_sparse_memory_e2e_v0"
                  },
                  "exchanges": {
                    "type": "array",
                    "maxItems": 0
                  },
                  "note": {
                    "const": "sdm_access"
                  },
                  "launch_config": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "schedule_family",
                      "route_block_half",
                      "read_route_block",
                      "write_route_block",
                      "state_block_d",
                      "route_materialization",
                      "fusion",
                      "state_num_warps",
                      "state_num_stages",
                      "read_route_num_warps",
                      "write_route_num_warps",
                      "route_backward_num_warps",
                      "route_num_stages"
                    ],
                    "properties": {
                      "schedule_family": {
                        "const": "native_route_then_partition_scan"
                      },
                      "route_block_half": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "read_route_block": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "write_route_block": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "state_block_d": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "route_materialization": {
                        "const": "explicit_logical_outputs"
                      },
                      "fusion": {
                        "const": "none"
                      },
                      "state_num_warps": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "state_num_stages": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "read_route_num_warps": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "write_route_num_warps": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "route_backward_num_warps": {
                        "const": 4
                      },
                      "route_num_stages": {
                        "const": 2
                      }
                    }
                  }
                }
              }
            },
            "obligations": {
              "type": "array",
              "maxItems": 0
            },
            "escape_hatch_count": {
              "const": 0
            }
          }
        }
      }
    },
    "state_stage_spans": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "profiled_step_wall_ms",
        "forward_ms",
        "backward_ms",
        "replaceable_fraction_diagnostic",
        "span_count"
      ],
      "properties": {
        "scope": {
          "type": "string"
        },
        "profiled_step_wall_ms": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "forward_ms": {
          "type": "number",
          "minimum": 0
        },
        "backward_ms": {
          "type": "number",
          "minimum": 0
        },
        "replaceable_fraction_diagnostic": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "span_count": {
          "type": "integer",
          "minimum": 2
        }
      }
    }
  }
}
