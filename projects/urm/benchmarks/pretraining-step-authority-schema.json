            "tokens_per_second",
            "scope"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "median_ms": {
              "$ref": "#/$defs/nonnegative"
            },
            "p95_ms": {
              "$ref": "#/$defs/nonnegative"
            },
            "minimum_ms": {
              "$ref": "#/$defs/nonnegative"
            },
            "raw_ms": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/nonnegative"
              }
            },
            "tokens_per_second": {
              "$ref": "#/$defs/nonnegative"
            },
            "scope": {
              "type": "string"
            }
          }
        },
        "memory": {
          "$ref": "#/$defs/memory"
        },
        "flops": {
          "$ref": "#/$defs/flops"
        },
        "compile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fullgraph",
            "graph_break_count",
            "unique_graphs",
            "recompilations"
          ],
          "properties": {
            "fullgraph": {
              "type": "boolean"
            },
            "graph_break_count": {
              "type": "integer",
              "minimum": 0
            },
            "unique_graphs": {
              "type": "integer",
              "minimum": 0
            },
            "recompilations": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "correctness_execution": {
          "enum": [
            "eager",
            "compile_fullgraph"
          ]
        },
        "matched_initial": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "parameters_sha256",
            "optimizer_sha256",
            "optimizer_step",
            "batches_sha256"
          ],
          "properties": {
            "parameters_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "optimizer_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "optimizer_step": {
              "const": 0
            },
            "batches_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "eager_internal_gradient_diagnostics": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/stepReport"
          }
        },
        "state_files": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "correctnessComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps",
        "passed"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "steps": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step",
              "loss_max_abs",
              "logit_max_abs",
              "gradient_norm_max_abs",
              "parameter_update_max_abs",
              "persistent_state_checksum_sum_max_abs",
              "persistent_state_checksum_normalized_max_abs",
              "mixer_input_gradients",
              "finite",
              "passed",
              "persistent_state_tensor_diagnostics"
            ],
            "properties": {
              "step": {
                "type": "integer",
                "minimum": 0
              },
              "loss_max_abs": {
                "$ref": "#/$defs/nonnegative"
              },
              "logit_max_abs": {
                "$ref": "#/$defs/nonnegative"
              },
              "gradient_norm_max_abs": {
                "$ref": "#/$defs/nonnegative"
              },
              "parameter_update_max_abs": {
                "$ref": "#/$defs/nonnegative"
              },
              "persistent_state_checksum_sum_max_abs": {
                "$ref": "#/$defs/nonnegative"
              },
              "persistent_state_checksum_normalized_max_abs": {
                "$ref": "#/$defs/nonnegative"
              },
              "mixer_input_gradients": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "block",
                    "cosine",
                    "max_abs"
                  ],
                  "properties": {
                    "block": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "cosine": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 1
                    },
                    "max_abs": {
                      "$ref": "#/$defs/nonnegative"
                    }
                  }
                }
              },
              "finite": {
                "type": "boolean"
              },
              "passed": {
                "type": "boolean"
              },
              "persistent_state_tensor_diagnostics": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "microbatch",
                    "block",
                    "max_abs",
                    "rms"
                  ],
                  "properties": {
                    "microbatch": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "block": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "max_abs": {
                      "$ref": "#/$defs/nonnegative"
                    },
                    "rms": {
                      "$ref": "#/$defs/nonnegative"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geometric_mean_optimizer_step_ratio",
        "hierarchical_ratio_ci95",
        "flat_diagnostic_ratio_ci95",
        "per_seed_median_ratios",
        "per_seed_p95_ratios",
        "memory_passed",
        "passed"
      ],
      "properties": {
        "geometric_mean_optimizer_step_ratio": {
          "$ref": "#/$defs/nonnegative"
        },
        "hierarchical_ratio_ci95": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "median",
            "lower",
            "upper"
          ],
          "properties": {
            "median": {
              "$ref": "#/$defs/nonnegative"
            },
            "lower": {
              "$ref": "#/$defs/nonnegative"
            },
            "upper": {
              "$ref": "#/$defs/nonnegative"
            }
          }
        },
        "flat_diagnostic_ratio_ci95": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lower",
            "upper"
          ],
          "properties": {
            "lower": {
              "$ref": "#/$defs/nonnegative"
            },
            "upper": {
              "$ref": "#/$defs/nonnegative"
            }
          }
        },
        "per_seed_median_ratios": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/nonnegative"
          }
        },
        "per_seed_p95_ratios": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/nonnegative"
          }
        },
        "memory_passed": {
          "type": "boolean"
        },
        "passed": {
          "type": "boolean"
        }
      }
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orders",
        "pairs",
        "correctness",
        "performance",
        "graph_passed",
        "passed",
        "eager_internal_gradient_diagnostics"
      ],
      "properties": {
        "orders": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "enum": [
                "upstream_sdm",
                "urm_native"
              ]
            }
          }
        },
        "pairs": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "upstream",
              "native"
            ],
            "properties": {
              "upstream": {
                "$ref": "#/$defs/process"
              },
              "native": {
                "$ref": "#/$defs/process"
              }
            }
          }
        },
        "correctness": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/correctnessComparison"
          }
        },
        "performance": {
          "$ref": "#/$defs/performance"
        },
        "graph_passed": {
          "type": "boolean"
        },
        "passed": {
          "type": "boolean"
        },
        "eager_internal_gradient_diagnostics": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/correctnessComparison"
          }
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_role",
        "runs",
        "graph_passed"
      ],
      "properties": {
        "semantic_role": {
          "const": "contextual_control_not_sparse_equivalence_comparator"
        },
        "runs": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/process"
          }
        },
        "graph_passed": {
          "type": "boolean"
        }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_kind",
        "generated_utc",
        "provenance",
        "frozen_configuration",
        "modes",
        "contextual_controls",
        "correctness_passed",
        "decision",
        "passed",
        "eager_vs_compiled_correctness",
        "production_launch_audits"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "artifact_kind": {
          "const": "pretraining_step_confirmation"
        },
        "generated_utc": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "frozen_configuration": {
          "type": "object"
        },
        "modes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eager",
            "compile_fullgraph"
          ],
          "properties": {
            "eager": {
              "$ref": "#/$defs/mode"
            },
            "compile_fullgraph": {
              "$ref": "#/$defs/mode"
            }
          }
        },
        "contextual_controls": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eager",
            "compile_fullgraph"
          ],
          "properties": {
            "eager": {
              "$ref": "#/$defs/control"
            },
            "compile_fullgraph": {
              "$ref": "#/$defs/control"
            }
          }
        },
        "correctness_passed": {
          "type": "boolean"
        },
        "decision": {
          "enum": [
            "superiority",
            "regression",
            "parity_without_superiority",
            "correctness_failure"
          ]
        },
        "passed": {
          "type": "boolean"
        },
        "eager_vs_compiled_correctness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "upstream",
            "native"
          ],
          "properties": {
            "upstream": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "$ref": "#/$defs/correctnessComparison"
              }
            },
            "native": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "$ref": "#/$defs/correctnessComparison"
              }
            }
          }
        },
        "production_launch_audits": {
          "type": "object",
          "required": [
            "eager",
            "compile_fullgraph"
          ],
          "additionalProperties": {
            "type": "object",
            "required": [
              "passed",
              "mode",
              "observed_launches",
              "plan"
            ],
            "properties": {
              "passed": {
                "const": true
              },
              "mode": {
                "enum": [
                  "eager",
                  "compile_fullgraph"
                ]
              },
              "observed_launches": {
                "type": "array",
                "minItems": 6
              },
              "plan": {
                "$ref": "#/$defs/compilerPlan"
              }
            }
          }
        }
      }
    }
  }
}
