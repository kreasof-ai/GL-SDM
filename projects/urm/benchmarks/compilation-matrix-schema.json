{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "URM NAS-facing compilation matrix artifact",
  "type": "object",
  "required": ["schema_version", "generated_utc", "provenance", "summary", "rows"],
  "properties": {
    "schema_version": { "const": 2 },
    "generated_utc": { "type": "string" },
    "provenance": {
      "type": "object",
      "required": ["git_revision", "dirty_tree", "benchmark_command"],
      "properties": {
        "git_revision": { "type": ["string", "null"], "minLength": 40 },
        "dirty_tree": { "type": "boolean" },
        "benchmark_command": { "type": "string" },
        "config_hash": { "type": "string" },
        "solver_version": { "type": ["string", "null"] },
        "constraint_model_hash": { "type": "string" },
        "constraint_model_hashes": { "type": "array" },
        "python": { "type": "string" },
        "platform": { "type": "string" },
        "pytorch": { "type": ["string", "null"] },
        "triton": { "type": ["string", "null"] },
        "cuda": { "type": ["string", "null"] },
        "driver": { "type": ["string", "null"] },
        "gpu": { "type": ["string", "null"] }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "presets_evaluated",
        "valid_semantic_programs",
        "generated_candidates",
        "rewrite_accepted",
        "rewrite_rejected",
        "routing_skeleton_compile_rate",
        "full_architecture_compile_rate",
        "native_lowering_rate",
        "upstream_adapter_rate",
        "escape_hatch_count"
      ],
      "properties": {
        "presets_evaluated": { "type": "integer", "minimum": 1 },
        "valid_semantic_programs": { "type": "integer" },
        "generated_candidates": { "type": "integer" },
        "rewrite_accepted": { "type": "integer" },
        "rewrite_rejected": { "type": "integer" },
        "candidates_rejected_by_imperative_checks": { "type": "integer" },
        "infeasible_candidates": { "type": "integer" },
        "candidates_ranked_out_by_objective": { "type": "integer" },
        "compile_probe_failures": { "type": ["integer", "null"] },
        "nogoods_added": { "type": ["integer", "null"] },
        "candidates_rejected_by_z3": { "type": "integer" },
        "verified_models": { "type": "integer" },
        "schedule_models_verified": { "type": "integer" },
        "unsat_categories": { "type": "array", "items": { "type": "string" } },
        "solver_time_ms": { "type": "number" },
        "compile_failures": { "type": "integer" },
        "routing_skeleton_compile_rate": {
          "type": "number", "minimum": 0, "maximum": 1
        },
        "full_architecture_compile_rate": {
          "type": "number", "minimum": 0, "maximum": 1
        },
        "native_lowering_rate": {
          "type": "number", "minimum": 0, "maximum": 1
        },
        "upstream_adapter_rate": {
          "type": "number", "minimum": 0, "maximum": 1
        },
        "escape_hatch_count": { "const": 0 }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "architecture_params",
          "schedule_params",
          "compiled",
          "escape_hatch_count"
        ],
        "properties": {
          "architecture_params": {
            "type": "object",
            "required": ["preset", "routing"],
            "properties": {
              "preset": { "type": "string" },
              "routing": { "type": "string" },
              "source_domain": { "type": "string" },
              "family_detail_lowered": { "type": "boolean" }
            }
          },
          "schedule_params": { "type": "object" },
          "valid_semantic_programs": { "type": "integer" },
          "candidates": { "type": "array" },
          "selected_candidate_ids": { "type": "array", "items": {"type": "string"} },
          "selection_policies": { "type": "array", "items": {"type": "string"} },
          "schedule_decisions": {
            "type": "array",
            "items": { "type": ["object", "null"] }
          },
          "rewrite_accepted": { "type": "integer" },
          "rewrite_rejected": { "type": "integer" },
          "rejected_by_training_intent": { "type": "integer" },
          "compiled": { "type": "boolean" },
          "decline_reason": { "type": ["string", "null"] },
          "anchors_selected": { "type": "array", "items": { "type": "string" } },
          "estimated_costs": { "type": "array" },
          "traces": { "type": "array" },
          "escape_hatch_count": { "const": 0 },
          "measured_performance_pointer": { "type": ["string", "null"] }
        }
      }
    }
  }
}
