{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "URM Sparse Memory E2E stage profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_kind", "generated_utc", "provenance", "case", "profiler"],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_kind": {"const": "stage_profile"},
    "generated_utc": {"type": "string"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_revision", "dirty_tree", "benchmark_command", "config_hash", "solver_version", "python", "platform", "gpu", "gpu_uuid", "pytorch", "triton", "cuda", "driver", "upstream"],
      "properties": {
        "git_revision": {"type": "string"},
        "dirty_tree": {"type": "boolean"},
        "benchmark_command": {"type": "string"},
        "config_hash": {"type": "string"},
        "solver_version": {"type": "string"},
        "python": {"type": "string"},
        "platform": {"type": "string"},
        "gpu": {"type": "string"},
        "gpu_uuid": {"type": "string"},
        "pytorch": {"type": "string"},
        "triton": {"type": "string"},
        "cuda": {"type": "string"},
        "driver": {"type": "string"},
        "upstream": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "expected_commit", "installed_commit", "checkout_root", "module_file", "checkout_dirty", "license", "installation", "source_usage", "runtime_versions"],
          "properties": {
            "repository": {"const": "https://github.com/facebookresearch/sparse-delta-memory"},
            "expected_commit": {"const": "183e7df809131b80ad4393741029d0f20fc3640b"},
            "installed_commit": {"const": "183e7df809131b80ad4393741029d0f20fc3640b"},
            "checkout_root": {"type": "string"}, "module_file": {"type": "string"}, "checkout_dirty": {"const": false},
            "license": {"const": "CC-BY-NC-4.0"}, "installation": {"type": "string"}, "source_usage": {"type": "string"},
            "runtime_versions": {
              "type": "object", "additionalProperties": false,
              "required": ["torch", "triton", "einops", "ninja"],
              "properties": {"torch": {"type": "string"}, "triton": {"type": "string"}, "einops": {"type": "string"}, "ninja": {"type": "string"}}
            }
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "operation", "classification", "parallel", "sequence", "slots", "dim", "writes", "reads", "dtype", "collision"],
      "properties": {
        "name": {"type": "string"}, "operation": {"enum": ["read_only", "update", "training"]}, "classification": {"enum": ["substantial", "host_bound"]},
        "parallel": {"type": "integer", "minimum": 1}, "sequence": {"type": "integer", "minimum": 1}, "slots": {"type": "integer", "minimum": 1}, "dim": {"type": "integer", "minimum": 1},
        "writes": {"type": "integer", "minimum": 0}, "reads": {"type": "integer", "minimum": 1}, "dtype": {"enum": ["float32", "bfloat16"]}, "collision": {"enum": ["low", "high", "recurrent"]}
      }
    },
    "profiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "nvtx_ranges", "trace", "events"],
      "properties": {
        "tool": {"type": "string"},
        "nvtx_ranges": {"type": "array", "minItems": 7, "items": {"type": "string"}},
        "trace": {"type": "string"},
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "count", "cpu_time_total_us", "self_device_time_total_us"],
            "properties": {
              "name": {"type": "string"},
              "count": {"type": "integer", "minimum": 1},
              "cpu_time_total_us": {"type": "number", "minimum": 0},
              "self_device_time_total_us": {"type": "number", "minimum": 0}
            }
          }
        }
      }
    }
  }
}
