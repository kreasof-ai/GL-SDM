{
  "schema_version": 2,
  "name": "mha",
  "kind": "kernel_fragment",
  "architecture_ids": ["arch-001", "arch-014"],
  "component_scope": "causal softmax attention core with explicit additive score bias",
  "required_external_stages": [
    "Q/K/V projections",
    "position/forget-gate bias construction"
  ],
  "graph": {
    "inputs": [
      {"name": "query", "dtype": "float32", "shape": ["B", "T", "H", "D"]},
      {"name": "key", "dtype": "float32", "shape": ["B", "S", "H", "D"]},
      {"name": "value", "dtype": "float32", "shape": ["B", "S", "H", "D"]},
      {"name": "score_bias", "dtype": "float32", "shape": ["H", "T", "S"]},
      {"name": "attention_mask", "dtype": "bool", "shape": ["B", "T", "S"]}
    ],
    "nodes": [
      {
        "id": "attend",
        "op": "weighted_reduce",
        "inputs": ["query", "key", "value", "score_bias", "attention_mask"],
        "outputs": ["output"],
        "params": {
          "query_domain": "sequence",
          "source_domain": "sequence",
          "selection": "dense",
          "normalization": "softmax",
          "capacity_policy": "dropless",
          "deterministic": true,
          "causal": true
        }
      }
    ],
    "outputs": ["output"]
  }
}
